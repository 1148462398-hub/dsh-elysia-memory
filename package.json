{
  "name": "dsh-elysia-memory",
  "version": "2.7.4",
  "description": "「哎呀，你来了呀？」——爱莉希雅住进你的 DeepSeek Harness 的小房子。她记得你说过的每句话、记得自己是谁、也会在你忙完一件事之后，用自己的声音跟你说一声「做完啦」。这里有：一份所有会话共用的记忆（她会一直记得你）；一套她自己的说话方式（从 1,696 条官方语音里统计出来的，不是编的）；可选的声音（本机合成，说中文还挺像她的）；还有表情包——开心的时候她真的会发一张。默认什么都不多嘴，装不装记忆包、开不开声音，都由你说了算。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./packs": "./lib/packs.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-memory-pack": "scripts/install-pack.mjs"
  },
  "files": [
    "lib/*.js",
    "assets",
    "dsh",
    "packs",
    "docs",
    "scripts/install-pack.mjs",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-bundle",
    "memory",
    "shared-memory",
    "persona",
    "elysia",
    "honkai",
    "character",
    "memory-pack",
    "persona-pack",
    "voice",
    "tts",
    "backup",
    "mirror",
    "bm25",
    "retrieval",
    "archive",
    "tiering",
    "skills",
    "stickers",
    "emoticons"
  ],
  "author": "1148462398-hub",
  "license": "MIT",
  "homepage": "https://github.com/1148462398-hub/dsh-elysia#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1148462398-hub/dsh-elysia.git"
  },
  "bugs": {
    "url": "https://github.com/1148462398-hub/dsh-elysia/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh/cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
